# Copy to .env and fill in. Never commit the real .env.
# Use the READ-ONLY Neon role (see README), not neondb_owner.
OMNIA_DB_DSN=postgresql://omnia_readonly:PASSWORD@ep-spring-firefly-POOLER.us-west-2.aws.neon.tech/neondb?sslmode=require
# Your Omnia user_id (everything is scoped to this tenant key).
OMNIA_USER_ID=your-omnia-user-id
